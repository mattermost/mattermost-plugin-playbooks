{{define "_styles"}}
<style>
/* Reset and base */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-size: 14px; line-height: 1.5; color: #1e1f22; background: #fff; padding: 24px; }

/* Page setup. Chrome and Edge print their own header (date, title) and
   footer (URL, page number) on each page edge that has no margin box, so
   every edge gets one: a running header with the run's title and the kind of
   report over a rule, and the page number at the bottom. The cover has
   neither. */
@page {
  size: A4;
  margin: 30mm 16mm 20mm;
  @top-left { content: "{{.Title}}"; vertical-align: bottom; margin-bottom: 8mm; padding-bottom: 3mm; border-bottom: 1px solid #e0e0e0; font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; font-size: 9pt; color: #72767d; }
  @top-center { content: ""; vertical-align: bottom; margin-bottom: 8mm; border-bottom: 1px solid #e0e0e0; }
  @top-right { content: "{{.Kind}}"; vertical-align: bottom; margin-bottom: 8mm; padding-bottom: 3mm; border-bottom: 1px solid #e0e0e0; font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; font-size: 9pt; color: #72767d; }
  @bottom-center { content: counter(page); vertical-align: top; padding-top: 6mm; font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; font-size: 9pt; color: #72767d; }
}
@page :first {
  @top-left { content: ""; border: none; }
  @top-center { content: ""; border: none; }
  @top-right { content: ""; border: none; }
  @bottom-center { content: ""; }
}

/* Typography */
h1 { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
h2 { font-size: 18px; font-weight: 600; margin: 32px 0 12px; border-bottom: 1px solid #e0e0e0; padding-bottom: 6px; }
h3 { font-size: 15px; font-weight: 600; margin: 16px 0 8px; }
p { margin: 8px 0; }
a { color: #166aab; text-decoration: none; }
a:hover { text-decoration: underline; }
ul, ol { margin: 8px 0 8px 24px; }
li { margin: 2px 0; }
code { font-family: var(--font-mono); font-size: 13px; background: #f0f0f0; border-radius: 3px; padding: 1px 5px; }
pre { font-family: var(--font-mono); font-size: 12px; background: #f0f0f0; border-radius: 4px; padding: 10px 12px; overflow-x: auto; margin: 8px 0; }
pre code { background: transparent; padding: 0; }
blockquote { border-left: 3px solid #d8d8d8; padding: 4px 12px; margin: 8px 0; color: #4f5660; }
table { border-collapse: collapse; margin: 8px 0; }
th, td { border: 1px solid #e0e0e0; padding: 6px 10px; text-align: left; }
th { background: #f8f9fb; font-weight: 600; }

/* Cover page */
.cover { text-align: center; padding: 96px 0; margin-bottom: 8px; border-bottom: 1px solid #e0e0e0; }
.cover__title { font-size: 32px; line-height: 1.25; margin-bottom: 0; }
.cover__kind { font-size: 18px; font-weight: 600; color: #3f4350; margin: 12px 0; }
.cover__date { color: #72767d; }

/* Details table (label / value rows) */
.details { width: 100%; margin: 16px 0; }
.details th { width: 30%; vertical-align: top; }

/* Status pill */
.status-pill { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
.status-pill--inprogress { background: #e8f4fd; color: #166aab; }
.status-pill--finished   { background: #e8f5e8; color: #1f6b35; }
.status-pill--neutral    { background: #f0f0f0; color: #4f5660; }

/* KPI stat cards */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 16px 0; }
.stat-card { background: #f8f9fb; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px 12px; }
.stat-card__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #72767d; }
.stat-card__value { font-size: 22px; font-weight: 700; margin-top: 4px; color: #1e1f22; }
.stat-card__hint  { font-size: 11px; color: #72767d; margin-top: 2px; }

/* Status updates */
.status-update { margin: 16px 0 36px; break-inside: avoid; }
.status-update__body { color: #3f4350; }
.status-update__body > :first-child { margin-top: 0; }
.status-update__body h1, .status-update__body h2, .status-update__body h3,
.status-update__body h4, .status-update__body h5, .status-update__body h6 { font-size: 15px; font-weight: 600; margin: 12px 0 4px; padding: 0; border: none; color: #1e1f22; }
.status-update__byline { margin-top: 12px; font-size: 13px; color: #1e1f22; }
.status-update__byline span { margin-left: 8px; color: #72767d; }

/* Boxed markdown (status update body, retro body, etc.) */
.boxed-md { background: #f8f9fb; border-left: 3px solid #d8d8d8; border-radius: 0 4px 4px 0; padding: 12px 16px; margin: 8px 0; }
.boxed-md > :first-child { margin-top: 0; }
.boxed-md > :last-child { margin-bottom: 0; }

/* Checklist */
.checklist { border: 1px solid #e0e0e0; border-radius: 6px; margin: 16px 0; }
.checklist__header { margin: 0; padding: 12px 20px; background: #f8f9fb; border-bottom: 1px solid #e0e0e0; border-radius: 6px 6px 0 0; font-size: 16px; font-weight: 600; color: #3f4350; break-after: avoid; }
.checklist__header span { margin-left: 8px; font-size: 13px; font-weight: 400; color: #72767d; }
.checklist__body { padding: 8px 20px; }
.checklist__body > .muted { margin: 8px 0; }
.task { display: flex; align-items: flex-start; gap: 12px; margin: 12px 0; break-inside: avoid; }
.task__check { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 16px; height: 16px; margin-top: 2px; border: 1px solid rgba(63, 67, 80, 0.32); border-radius: 3px; background: #fff; }
.task__check--done { border-color: #1c58d9; background: #1c58d9; }
.task__check svg { width: 12px; height: 12px; }
.task--skipped .task__title { text-decoration: line-through; color: #72767d; }
.task__body { flex: 1; min-width: 0; }
.task__title { font-size: 14px; color: #1e1f22; }
.task__meta { font-size: 13px; color: #72767d; margin-top: 6px; }
.task__meta-cmd { font-family: var(--font-mono); font-size: 12px; background: rgba(63, 67, 80, 0.06); color: #1e1f22; border-radius: 3px; padding: 1px 5px; }
.task__desc { font-size: 13px; color: #3f4350; margin-top: 4px; }
.task__desc ul, .task__desc ol { margin: 4px 0 4px 18px; }

/* Timeline */
.timeline-event { display: grid; grid-template-columns: 140px 1fr; gap: 12px; margin: 8px 0; font-size: 13px; align-items: start; padding: 6px 0; border-top: 1px solid #f0f0f0; }
.timeline-event:first-of-type { border-top: none; }
.timeline-event__date { color: #72767d; font-size: 12px; margin-top: 2px; }
.timeline-event__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #72767d; padding: 2px 8px; background: rgba(63, 67, 80, 0.06); border-radius: 12px; text-align: center; align-self: start; }
.timeline-event__headline { color: #1e1f22; }
.timeline-event__detail { color: #72767d; margin-top: 4px; font-size: 12px; }

/* Category accent colors on the label chip */
.timeline-event--lifecycle .timeline-event__label { background: rgba(28, 88, 217, 0.10); color: #1c58d9; }
.timeline-event--tasks     .timeline-event__label { background: rgba(31, 107, 53, 0.10); color: #1f6b35; }
.timeline-event--status    .timeline-event__label { background: rgba(22, 106, 171, 0.10); color: #166aab; }
.timeline-event--people    .timeline-event__label { background: rgba(120, 67, 152, 0.10); color: #784398; }
.timeline-event--retrospective .timeline-event__label { background: rgba(204, 142, 53, 0.10); color: #90601c; }
.timeline-event--command   .timeline-event__label { background: rgba(63, 67, 80, 0.10); color: #3f4350; }

/* Transcript */
.transcript-thread { border-left: 3px solid #e0e0e0; padding-left: 12px; margin: 12px 0; }
.transcript-reply  { border-left: 3px solid #f0f0f0; padding-left: 10px; margin: 8px 0 8px 16px; }
.transcript-reply--orphan { border-left-color: #f4cb47; }
.transcript-orphans-heading { font-size: 13px; font-weight: 600; color: #72767d; margin: 20px 0 4px; }
.transcript-orphans-note { font-size: 12px; margin: 0 0 8px; }
.msg-header { font-size: 12px; font-weight: 600; color: #1e1f22; margin-bottom: 4px; }
.msg-header span  { font-weight: 400; color: #72767d; margin-left: 6px; }
.msg-body { font-size: 13px; }
.msg-body > :first-child { margin-top: 0; }
.msg-body > :last-child { margin-bottom: 0; }

/* Divider */
.divider { border: none; border-top: 1px solid #e0e0e0; margin: 24px 0; }

/* Muted text */
.muted { color: #72767d; font-style: italic; font-size: 13px; margin: 8px 0; }

/* Print optimizations */
@media print {
  /* Keep the colors (filled checkboxes, card headers) even when the print
     dialog leaves out background graphics. */
  body { padding: 0; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  /* The cover fills the first page; every section starts on a new one. */
  .cover { min-height: 240mm; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0; border-bottom: none; break-after: page; }
  .section { break-before: page; }
  .section > h2:first-child { margin-top: 0; }
  .boxed-md, .transcript-thread { break-inside: avoid; }
}
</style>
{{end}}
