<!doctype html>
<html lang="{{.Report.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'none'; script-src 'none'; object-src 'none'; connect-src 'none'; worker-src 'none'; media-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
  <title>{{.Report.Title}}</title>
  <style>{{.FontCSS}}</style>
  {{template "_styles" .}}
</head>
<body>
  {{- with .Report}}
  <h1>{{.Title}}</h1>
  <span class="status-pill status-pill--neutral">{{.Visibility}}</span>

  <div class="stat-grid">
    {{- range .Stats}}
    <div class="stat-card">
      <div class="stat-card__label">{{.Label}}</div>
      <div class="stat-card__value">{{.Value}}</div>
    </div>
    {{- end}}
  </div>

  <p class="meta-strip">
    {{range $i, $f := .Meta}}{{if $i}} · {{end}}<strong>{{$f.Label}}:</strong> {{$f.Value}}{{end}}
  </p>

  <h2>{{.Description.Title}}</h2>
  {{if .Description.Body}}<div class="boxed-md">{{markdown .Description.Body}}</div>
  {{else}}<p class="muted">{{.Description.Empty}}</p>{{end}}

  <h2>{{.Members.Title}}</h2>
  {{- if .Members.Members}}
  <div class="member-grid">
    {{range .Members.Members}}<span class="member-chip">{{.Name}}{{if .Roles}} ({{.Roles}}){{end}}</span>{{end}}
  </div>
  {{else}}<p class="muted">{{.Members.Empty}}</p>{{end}}

  <h2>{{.Checklists.Title}}</h2>
  {{- range .Checklists.Checklists}}
  <h3>{{.Title}} ({{.Progress}})</h3>
  <div class="checklist">
    {{- range .Items}}
    <div class="task">
      <input type="checkbox" disabled>
      <div class="task__body">
        <div class="task__title">{{markdownInline .Title}}</div>
        {{if .Command}}<div class="task__meta"><code class="task__meta-cmd">{{.Command}}</code></div>{{end}}
        {{if .Description}}<div class="task__desc">{{markdown .Description}}</div>{{end}}
      </div>
    </div>
    {{else}}<p class="muted">{{.Empty}}</p>
    {{- end}}
  </div>
  {{else}}<p class="muted">{{.Checklists.Empty}}</p>{{end}}

  {{- range .Settings}}
  <h2>{{.Title}}</h2>
  {{- if .Configured}}
  <p class="meta-strip">
    {{range $i, $f := .Meta}}{{if $i}} · {{end}}<strong>{{$f.Label}}:</strong> {{$f.Value}}{{end}}
  </p>
  {{if .Template}}<div class="boxed-md">{{markdown .Template}}</div>{{end}}
  {{- if .Metrics}}
  <h3>{{.MetricsTitle}}</h3>
  {{- range .Metrics}}
  <p><strong>{{.Title}}</strong> ({{.Value}}){{if .Description}} — <span class="muted">{{.Description}}</span>{{end}}</p>
  {{- end}}
  {{- end}}
  {{else}}<p class="muted">{{.Empty}}</p>{{end}}
  {{- end}}

  {{- with .Automations}}
  <h2>{{.Title}}</h2>
  {{- if .Configured}}

  {{- with .BroadcastChannels}}
  <h3>{{.Title}}</h3>
  {{- if .Items}}
  <div class="member-grid">
    {{range .Items}}<span class="member-chip">{{.}}</span>{{end}}
  </div>
  {{else}}<p class="muted">{{.Empty}}</p>{{end}}
  {{- end}}

  {{- range .CodeLists}}
  <h3>{{.Title}}</h3>
  {{- if .Items}}
  <ul>
    {{range .Items}}<li><code>{{.}}</code></li>{{end}}
  </ul>
  {{else}}<p class="muted">{{.Empty}}</p>{{end}}
  {{- end}}

  {{else}}<p class="muted">{{.Empty}}</p>{{end}}
  {{- end}}

  {{- if .Footer}}
  <hr class="divider">
  <p class="muted">{{.Footer}}</p>
  {{- end}}
  {{- end}}
</body>
</html>
