<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'none'; script-src 'none'; object-src 'none'; connect-src 'none'; worker-src 'none'; media-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
  <title>{{.Title}}</title>
  <style>
:root {
  --font-sans:  "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --font-mono:  "SFMono-Regular", Consolas, "Liberation Mono", Menlo,
                Courier, monospace;
}
body { font-family: var(--font-sans); }
h1, h2 { font-family: Metropolis, var(--font-sans); }
code, pre { font-family: var(--font-mono); }
</style>
  {{template "_styles" .}}
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" style="display: none">
    <symbol id="icon-lifecycle" viewBox="0 0 24 24"><path d="M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21M11,7H13V13H11V7M11,15H13V17H11V15Z"/></symbol>
    <symbol id="icon-status" viewBox="0 0 24 24"><path d="M12.4,6l0.4,2H18v6h-3.4l-0.4-2H7V6H12.4 M14,4H5v17h2v-7h5.6l0.4,2h7V6h-5.6"/></symbol>
    <symbol id="icon-update" viewBox="0 0 24 24"><path d="M21,10.12H14.22L16.96,7.3C14.23,4.6 9.81,4.5 7.08,7.2C4.35,9.91 4.35,14.28 7.08,17C9.81,19.7 14.23,19.7 16.96,17C18.32,15.65 19,14.08 19,12.1H21C21,14.08 20.12,16.65 18.36,18.39C14.85,21.87 9.15,21.87 5.64,18.39C2.14,14.92 2.11,9.28 5.62,5.81C9.13,2.34 14.76,2.34 18.27,5.81L21,3V10.12M12.5,8V12.25L16,14.33L15.28,15.54L11,13V8H12.5Z"/></symbol>
    <symbol id="icon-tasks" viewBox="0 0 24 24"><path d="M7,5H21V7H7V5M7,13V11H21V13H7M4,4.5A1.5,1.5 0 0,1 5.5,6A1.5,1.5 0 0,1 4,7.5A1.5,1.5 0 0,1 2.5,6A1.5,1.5 0 0,1 4,4.5M4,10.5A1.5,1.5 0 0,1 5.5,12A1.5,1.5 0 0,1 4,13.5A1.5,1.5 0 0,1 2.5,12A1.5,1.5 0 0,1 4,10.5M7,19V17H21V19H7M4,16.5A1.5,1.5 0 0,1 5.5,18A1.5,1.5 0 0,1 4,19.5A1.5,1.5 0 0,1 2.5,18A1.5,1.5 0 0,1 4,16.5Z"/></symbol>
    <symbol id="icon-edit" viewBox="0 0 24 24"><path d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z"/></symbol>
    <symbol id="icon-people" viewBox="0 0 24 24"><path d="M19.2,15.9L16,14c0.2-0.3,0.5-0.6,0.7-1c0.8-1.4,1.3-3.2,1.3-5c0-3.6-2.4-6-6-6S6,4.4,6,8c0,1.8,0.5,3.6,1.3,5.1c0.2,0.4,0.4,0.7,0.7,1L4.8,16C3.7,16.4,3,17.6,3,18.8C3,20.6,4.4,22,6.2,22h11.6c1.8,0,3.2-1.4,3.2-3.2 C21,17.6,20.3,16.4,19.2,15.9z M8,8c0-2.8,1.8-4,4-4s4,1.2,4,4c0,1.8-0.6,3.8-1.8,5c-0.6,0.6-1.3,1-2.2,1s-1.6-0.4-2.2-1 C8.6,11.8,8,9.8,8,8z M17.8,20H6.2C5.5,20,5,19.5,5,18.8c0-0.5,0.3-0.9,0.7-1.1l3.9-2.3c0.8,0.4,1.6,0.6,2.4,0.6s1.6-0.2,2.3-0.6 l3.9,2.3c0.4,0.2,0.7,0.6,0.7,1.1C19,19.5,18.5,20,17.8,20z"/></symbol>
    <symbol id="icon-cancel" viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12C4,13.85 4.63,15.55 5.68,16.91L16.91,5.68C15.55,4.63 13.85,4 12,4M12,20A8,8 0 0,0 20,12C20,10.15 19.37,8.45 18.32,7.09L7.09,18.32C8.45,19.37 10.15,20 12,20Z"/></symbol>
    <symbol id="icon-clock" viewBox="0 0 24 24"><path d="M12,20c4.4,0,8-3.6,8-8s-3.6-8-8-8s-8,3.6-8,8S7.6,20,12,20 M12,2c5.5,0,10,4.5,10,10s-4.5,10-10,10S2,17.5,2,12S6.5,2,12,2 M15.535,16.949L11,12.414V7h2v4.586l3.949,3.949L15.535,16.949z"/></symbol>
  </svg>
  <section class="cover">
    <h1 class="cover__title">{{.Title}}</h1>
    <p class="cover__kind">{{.Kind}}</p>
    {{- if .Status.Value}}
    <span class="status-pill status-pill--{{.StatusKind}}">{{.Status.Value}}</span>
    {{- end}}
    {{if .Generated}}<p class="cover__date">{{.Generated}}</p>{{end}}
  </section>

  <section class="section">
  <h2>{{.Summary.Title}}</h2>
  {{if .Summary.Body}}<div class="summary">{{markdown .Summary.Body}}</div>
  {{else}}<p class="muted">{{.Summary.Empty}}</p>{{end}}

  <div class="stat-grid">
    {{- range .Stats}}
    <div class="stat-card">
      <div class="stat-card__label">{{.Label}}</div>
      <div class="stat-card__value">{{.Value}}</div>
      {{if .Hint}}<div class="stat-card__hint">{{.Hint}}</div>{{end}}
    </div>
    {{- end}}
  </div>

  <div class="details">
    <div class="details__title">{{.DetailsTitle}}</div>
    <table>
      {{- range .Details}}
      <tr><th>{{.Label}}</th><td>{{if .URL}}<a href="{{.URL}}">{{.Value}}</a>{{else}}{{.Value}}{{end}}</td></tr>
      {{- end}}
    </table>
  </div>
  </section>

  <section class="section">
  <h2>{{.StatusUpdates.Title}}</h2>
  {{- range .StatusUpdates.Updates}}
  <div class="status-update">
    {{if .Body}}<div class="status-update__body">{{markdown .Body}}</div>{{else}}<p class="muted">{{$.StatusUpdates.NoMessage}}</p>{{end}}
    <div class="status-update__byline">{{.Author}}<span>{{.Date}}</span></div>
  </div>
  {{else}}<p class="muted">{{.StatusUpdates.Empty}}</p>{{end}}
  </section>

  {{- if not .Timeline.Omitted}}
  <section class="section">
  <h2>{{.Timeline.Title}}</h2>
  {{- if .Timeline.Events}}
  <div class="timeline">
    {{- range .Timeline.Events}}
    <div class="timeline-event">
      <span class="timeline-event__icon">{{if .Icon}}<svg aria-hidden="true"><use href="#icon-{{.Icon}}"/></svg>{{end}}</span>
      <div class="timeline-event__body">
        <div class="timeline-event__headline">{{.Headline}}</div>
        {{- if or .DetailPlain .Detail}}
        <div class="timeline-event__detail">{{.DetailPlain}}{{if and .DetailPlain .Detail}} {{end}}{{markdownInline .Detail}}</div>
        {{- end}}
        <div class="timeline-event__date">{{.Date}}</div>
      </div>
    </div>
    {{- end}}
  </div>
  {{- else}}
  <p class="muted">{{.Timeline.Empty}}</p>
  {{- end}}
  </section>
  {{- end}}

  {{- if not .Retrospective.Omitted}}
  <section class="section">
  <h2>{{.Retrospective.Title}}</h2>
  {{- if .Retrospective.Note}}
  <p class="muted">{{.Retrospective.Note}}</p>
  {{- end}}
  {{if .Retrospective.Body}}<div class="boxed-md">{{markdown .Retrospective.Body}}</div>
  {{else if not (or .Retrospective.Metrics .Retrospective.Note)}}<p class="muted">{{.Retrospective.Empty}}</p>{{end}}
  {{- if .Retrospective.Metrics}}
  <h3>{{.Retrospective.MetricsTitle}}</h3>
  {{- range .Retrospective.Metrics}}
  <p><strong>{{.Title}}:</strong> {{.Value}}{{if .Description}} · <span class="muted">{{.Description}}</span>{{end}}</p>
  {{- end}}
  {{- end}}
  </section>
  {{- end}}

  {{- if not .Tasks.Omitted}}
  <section class="section">
  <h2>{{.Tasks.Title}}</h2>
  {{- range $c, $cl := .Tasks.Checklists}}
  <div class="checklist">
    <h3 class="checklist__header">{{.Title}} <span>{{.Progress}}</span></h3>
    <div class="checklist__body">
    {{- range $i, $it := .Items}}
    <div class="task{{if .Skipped}} task--skipped{{end}}">
      <span class="task__check{{if .Done}} task__check--done{{end}}" role="checkbox" aria-checked="{{.Done}}" aria-disabled="true" aria-labelledby="task-{{$c}}-{{$i}}">{{if .Done}}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}</span>
      <div class="task__body">
        <div class="task__title" id="task-{{$c}}-{{$i}}">{{markdownInline .Title}}</div>
        {{if .Description}}<div class="task__desc">{{markdown .Description}}</div>{{end}}
        {{if or .Assignee .Due .Command}}<div class="task__meta">{{.Assignee}}{{if .Due}} · {{.Due}}{{end}}{{if .Command}} · <code class="task__meta-cmd">{{.Command}}</code>{{end}}</div>{{end}}
        {{if .Completed}}<div class="task__meta">{{.Completed}}</div>{{end}}
      </div>
    </div>
    {{else}}<p class="muted">{{.Empty}}</p>
    {{- end}}
    </div>
  </div>
  {{else}}<p class="muted">{{.Tasks.Empty}}</p>{{end}}
  </section>
  {{- end}}

  {{- with .Transcript}}{{if not .Omitted}}
  <section class="section">
  <h2>{{.Title}}</h2>
  {{- if not .HasPosts}}
  <p class="muted">{{.Empty}}</p>
  {{- else if .Chronological}}
    {{- range .Posts}}
    <div class="{{if .IsReply}}transcript-reply{{else}}transcript-thread{{end}}">
      <div class="msg-header">{{if .IsReply}}↳ {{end}}{{.Author}}<span>{{.Date}}{{if .ParentLabel}} · {{.ParentLabel}}{{end}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
    </div>
    {{- end}}
  {{- else}}
    {{- range .Threads}}
    <div class="transcript-thread">
      <div class="msg-header">{{.Author}}<span>{{.Date}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
      {{- range .Replies}}
      <div class="transcript-reply">
        <div class="msg-header">↳ {{.Author}}<span>{{.Date}}</span></div>
        {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
      </div>
      {{- end}}
    </div>
    {{- end}}
    {{- if .Orphans}}
    <h3 class="transcript-orphans-heading">{{.OrphansTitle}}</h3>
    <p class="muted transcript-orphans-note">{{.OrphansNote}}</p>
    {{- range .Orphans}}
    <div class="transcript-reply transcript-reply--orphan">
      <div class="msg-header">↳ {{.Author}}<span>{{.Date}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
    </div>
    {{- end}}
    {{- end}}
  {{- end}}
  {{- if .Truncated}}
  <p class="muted">{{.Truncated}}</p>
  {{- end}}
  </section>
  {{- end}}{{end}}

  {{- if .Footer}}
  <hr class="divider">
  <p class="muted">{{.Footer}}</p>
  {{- end}}
</body>
</html>
