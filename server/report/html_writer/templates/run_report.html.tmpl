<!doctype html>
<html lang="{{.Report.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'none'; script-src 'none'; object-src 'none'; connect-src 'none'; worker-src 'none'; media-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
  <title>{{.Report.Title}}</title>
  <style>{{.FontCSS}}</style>
  {{template "_styles" .}}
</head>
<body>
  {{- with .Report}}
  <section class="cover">
    <h1 class="cover__title">{{.Title}}</h1>
    <p class="cover__kind">{{.Kind}}</p>
    {{- if .Status.Value}}
    <span class="status-pill status-pill--{{.StatusKind}}">{{.Status.Value}}</span>
    {{- end}}
    {{if .Generated}}<p class="cover__date">{{.Generated}}</p>{{end}}
  </section>

  <section class="section">
  <h2>{{.Summary.Title}}</h2>
  {{if .Summary.Body}}<div class="boxed-md">{{markdown .Summary.Body}}</div>
  {{else}}<p class="muted">{{.Summary.Empty}}</p>{{end}}

  <div class="stat-grid">
    {{- range .Stats}}
    <div class="stat-card">
      <div class="stat-card__label">{{.Label}}</div>
      <div class="stat-card__value">{{.Value}}</div>
      {{if .Hint}}<div class="stat-card__hint">{{.Hint}}</div>{{end}}
    </div>
    {{- end}}
  </div>

  <table class="details">
    {{- range .Meta}}
    <tr><th>{{.Label}}</th><td>{{.Value}}</td></tr>
    {{- end}}
    {{- if .Participants}}
    <tr><th>{{.ParticipantsLabel}}</th><td>{{range $i, $p := .Participants}}{{if $i}}, {{end}}{{$p}}{{end}}</td></tr>
    {{- end}}
  </table>
  </section>

  <section class="section">
  <h2>{{.StatusUpdates.Title}}</h2>
  {{- range .StatusUpdates.Updates}}
  <div class="card">
    <div class="card__header">{{.Author}}<span>{{.Date}}</span></div>
    {{if .Body}}<div class="boxed-md">{{markdown .Body}}</div>{{else}}<p class="muted">{{$.Report.StatusUpdates.NoMessage}}</p>{{end}}
  </div>
  {{else}}<p class="muted">{{.StatusUpdates.Empty}}</p>{{end}}
  </section>

  {{- if not .Timeline.Omitted}}
  <section class="section">
  <h2>{{.Timeline.Title}}</h2>
  {{- range .Timeline.Events}}
  <div class="timeline-event timeline-event--{{.Category}}">
    <span class="timeline-event__label">{{.TypeLabel}}</span>
    <div class="timeline-event__body">
      <div class="timeline-event__headline">{{markdownInline .Headline}}</div>
      {{if .Detail}}<div class="timeline-event__detail">{{markdownInline .Detail}}</div>{{end}}
      <div class="timeline-event__date">{{.Date}}</div>
    </div>
  </div>
  {{else}}<p class="muted">{{.Timeline.Empty}}</p>{{end}}
  </section>
  {{- end}}

  {{- if not .Retrospective.Omitted}}
  <section class="section">
  <h2>{{.Retrospective.Title}}</h2>
  {{if .Retrospective.Body}}<div class="boxed-md">{{markdown .Retrospective.Body}}</div>
  {{else if not .Retrospective.Metrics}}<p class="muted">{{.Retrospective.Empty}}</p>{{end}}
  {{- if .Retrospective.Metrics}}
  <h3>{{.Retrospective.MetricsTitle}}</h3>
  {{- range .Retrospective.Metrics}}
  <p><strong>{{.Title}}:</strong> {{.Value}}{{if .Description}} — <span class="muted">{{.Description}}</span>{{end}}</p>
  {{- end}}
  {{- end}}
  </section>
  {{- end}}

  {{- if not .Tasks.Omitted}}
  <section class="section">
  <h2>{{.Tasks.Title}}</h2>
  {{- range .Tasks.Checklists}}
  <h3>{{.Title}} ({{.Progress}})</h3>
  <div class="checklist">
    {{- range .Items}}
    <div class="task{{if .Skipped}} task--skipped{{end}}">
      <input type="checkbox" {{if .Done}}checked{{end}} disabled>
      <div class="task__body">
        <div class="task__title">{{markdownInline .Title}}</div>
        {{if or .Assignee .Due .Command}}<div class="task__meta">{{.Assignee}}{{if .Due}} · {{.Due}}{{end}}{{if .Command}} · <code class="task__meta-cmd">{{.Command}}</code>{{end}}</div>{{end}}
        {{if .Completed}}<div class="task__meta">{{.Completed}}</div>{{end}}
        {{if .Description}}<div class="task__desc">{{markdown .Description}}</div>{{end}}
      </div>
    </div>
    {{else}}<p class="muted">{{.Empty}}</p>
    {{- end}}
  </div>
  {{else}}<p class="muted">{{.Tasks.Empty}}</p>{{end}}
  </section>
  {{- end}}

  {{- with .Transcript}}{{if not .Omitted}}
  <section class="section">
  <h2>{{.Title}}</h2>
  {{- if not .HasPosts}}
  <p class="muted">{{.Empty}}</p>
  {{- else if .Chronological}}
    {{- range .Posts}}
    <div class="{{if .IsReply}}transcript-reply{{else}}transcript-thread{{end}}">
      <div class="msg-header">{{if .IsReply}}↳ {{end}}{{.Author}}<span>{{.Date}}{{if .ParentLabel}} · {{.ParentLabel}}{{end}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
    </div>
    {{- end}}
  {{- else}}
    {{- range .Threads}}
    <div class="transcript-thread">
      <div class="msg-header">{{.Author}}<span>{{.Date}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
      {{- range .Replies}}
      <div class="transcript-reply">
        <div class="msg-header">↳ {{.Author}}<span>{{.Date}}</span></div>
        {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
      </div>
      {{- end}}
    </div>
    {{- end}}
    {{- if .Orphans}}
    <h3 class="transcript-orphans-heading">{{.OrphansTitle}}</h3>
    <p class="muted transcript-orphans-note">{{.OrphansNote}}</p>
    {{- range .Orphans}}
    <div class="transcript-reply transcript-reply--orphan">
      <div class="msg-header">↳ {{.Author}}<span>{{.Date}}</span></div>
      {{if .Body}}<div class="msg-body">{{markdown .Body}}</div>{{end}}
    </div>
    {{- end}}
    {{- end}}
  {{- end}}
  {{- if .Truncated}}
  <p class="muted">{{.Truncated}}</p>
  {{- end}}
  </section>
  {{- end}}{{end}}

  {{- if .Footer}}
  <hr class="divider">
  <p class="muted">{{.Footer}}</p>
  {{- end}}
  {{- end}}
</body>
</html>
